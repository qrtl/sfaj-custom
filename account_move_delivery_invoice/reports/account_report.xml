<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="delivery_invoices" model="ir.actions.report">
        <field name="name">Delivery Invoices</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field
            name="report_name"
        >account_move_delivery_invoice.report_delivery_invoice</field>
        <field
            name="report_file"
        >account_move_delivery_invoice.report_delivery_invoice</field>
        <field
            name="print_report_name"
        >'Delivery Invoice - %s - %s' % (object.partner_id.name or '', object.name)</field>
        <field name="binding_model_id" ref="account.model_account_move" />
        <field name="binding_type">report</field>
        <field
            name="groups_id"
            eval="[(4, ref('account.group_account_invoice')), (4, ref('account.group_account_readonly'))]"
        />
    </record>
</odoo>
